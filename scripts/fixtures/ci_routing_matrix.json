      "run_security": true,
      "run_content": true,
      "run_pdf": true,
      "run_reference": true
    },
    {
      "change": "content/guide.mdx only",
      "run_validate": false,
      "run_security": false,
      "run_content": true,
      "run_pdf": false,
      "run_reference": false
